# syntax=docker/dockerfile:1
# Isaac ROS + Doosan Integration Dockerfile (auto build-doosan)

ARG BASE_IMAGE=ros2_humble-image
FROM ${BASE_IMAGE}

# Environment setup
ENV DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash \
    LANG=en_US.UTF-8 \
    ROS_DISTRO=humble \
    ISAAC_ROS_WS=/workspaces/isaac_ros-dev \
    DOOSAN_WS=/workspaces/ros2_ws \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    ROS_PYTHON_VERSION=3

# bash with pipefail
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Update expired ROS keyring
RUN rm -f /usr/share/keyrings/ros-archive-keyring.gpg && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg

# Install dependencies + docker CLI
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        wget \
        curl \
        gnupg2 \
        lsb-release && \
    sh -c 'echo "deb http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list' && \
    wget http://packages.osrfoundation.org/gazebo.key -O - | apt-key add - && \
    apt-get update --allow-releaseinfo-change

# Install ROS 2, MoveIt, Gazebo, ros-gz, controllers
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros2-control \
        ros-${ROS_DISTRO}-ros2-controllers \
        ros-${ROS_DISTRO}-controller-manager \
        ros-${ROS_DISTRO}-hardware-interface \
        ros-${ROS_DISTRO}-control-msgs \
        ros-${ROS_DISTRO}-moveit-core \
        ros-${ROS_DISTRO}-moveit \
        ros-${ROS_DISTRO}-moveit-ros-planning \
        ros-${ROS_DISTRO}-moveit-planners \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-vision-opencv \
        ros-${ROS_DISTRO}-gazebo-msgs \
        ros-${ROS_DISTRO}-ros-gz \
        ros-${ROS_DISTRO}-ros-gz-sim \
        ros-${ROS_DISTRO}-ros-gz-bridge \
        ros-${ROS_DISTRO}-ros-gz-image \
        ros-${ROS_DISTRO}-gz-ros2-control \
    && rm -rf /var/lib/apt/lists/*

# Set Docker
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y ca-certificates curl && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc

RUN echo \
"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
$(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
tee /etc/apt/sources.list.d/docker.list > /dev/null

RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Copy build script
COPY scripts/build-doosan.sh /usr/local/bin/scripts/entrypoint_additions/00-build-doosan.user.sh
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/00-build-doosan.user.sh

WORKDIR /workspaces/isaac_ros-dev
CMD ["/bin/bash"]
