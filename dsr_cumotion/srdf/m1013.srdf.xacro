<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="m1013">
  <xacro:arg name="name"   default="m1013"/>
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find dsr_cumotion)/srdf/m1013_macro.srdf.xacro"/>
  <xacro:include filename="$(find dsr_cumotion)/srdf/robotiq_2f_85.srdf.xacro"/>

  <xacro:m1013_srdf robot_name="$(arg name)"/>
  <xacro:robotiq_2f85_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- robotiq base link and wrist -->
  <disable_collisions link1="robotiq_85_base_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="tool0" reason="Adjacent"/>

  <disable_collisions link1="robotiq_85_left_finger_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="tool0" reason="Never"/>

  <disable_collisions link1="robotiq_85_right_finger_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="link_5" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="tool0" reason="Never"/>

  <disable_collisions link1="robotiq_85_base_link" link2="vision_bracket" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="d435i_camera" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="d435i_camera" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="d435i_camera" reason="Never"/>

  <group name="manipulator">
    <chain base_link="base_link" tip_link="grasp_frame"/>
  </group>

  <group_state name="all-zeros" group="manipulator">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <group_state name="set" group="manipulator">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="1.5708"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="1.5708"/>
    <joint name="joint_6" value="0"/>
  </group_state>

</robot>