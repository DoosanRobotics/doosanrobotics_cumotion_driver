<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="m1013">

  <!-- Arguments -->
  <xacro:arg name="color" default="white"/>
  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="use_mujoco" default="false"/>
  <xacro:arg name="host" default=""/>
  <xacro:arg name="port" default=""/>
  <xacro:arg name="rt_host" default=""/>
  <xacro:arg name="mode" default=""/>
  <xacro:arg name="model" default=""/>

  <!-- Gripper-related args -->
  <xacro:arg name="gripper_prefix"      default=""/>
  <xacro:arg name="gripper_parent_link" default="vision_bracket"/>

  <!--  world → base_link
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint> -->

  <xacro:include filename="$(find dsr_cumotion)/urdf/macro.m1013.white.xacro"/>
  <xacro:m1013 namespace="$(arg namespace)"/>

  <link name="tool0"/>
  <joint name="joint_6-tool0" type="fixed">
    <origin rpy="0 0 1.57" xyz="0 0 0"/>
    <parent link="link_6"/>
    <child link="tool0"/>
  </joint>

  <!-- ros2_control for robot -->
  <xacro:include filename="$(find dsr_cumotion)/urdf/m1013.ros2_control.xacro"/>
  <xacro:m1013_ros2_control
    name="m1013"
    host="$(arg host)"
    rt_host="$(arg rt_host)"
    port="$(arg port)"
    mode="$(arg mode)"
    model="$(arg model)"/>

  <!-- Robotiq 2F-85 gripper -->
  <xacro:include filename="$(find dsr_cumotion)/urdf/robotiq.xacro"/>
  <xacro:robotiq_85
    parent="$(arg gripper_parent_link)"
    prefix="$(arg gripper_prefix)"/>

  <xacro:include filename="$(find dsr_cumotion)/urdf/robotiq.ros2_control.xacro"/>
  <xacro:robotiq_gripper_system
    mode="$(arg mode)"
    joint_name="$(arg gripper_prefix)robotiq_85_left_knuckle_joint"
    system_name="$(arg gripper_prefix)robotiq_gripper_system"
    pos_min="0.0" pos_max="0.8" init_pos="0.0"
    speed_mult="1.0" force_mult="0.5"
    max_speed="0.150" max_force="235.0"
    mock_sensor_commands="true"/>

</robot>